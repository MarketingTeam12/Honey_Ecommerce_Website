# Public Razorpay Key ID (do NOT put Razorpay Key Secret in frontend .env files)
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id

# Backend API origin (Node/Express server mounting /make-server-a67f0635 and /api)
# Local dev/preview:
# VITE_API_BASE_URL=http://localhost:3000
# Production (Single Hostinger app - relative to same origin):
VITE_API_BASE_URL=/api
